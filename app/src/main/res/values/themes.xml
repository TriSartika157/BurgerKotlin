<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BurgerKotlin" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#37A83F</item>
        <item name="colorSecondary">#37A83F</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <style name="Theme.MyApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="postSplashScreenTheme">@style/Theme.BurgerKotlin</item>
    </style>

    <style name="Theme.BurgerKotlin.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.BurgerKotlin.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.BurgerKotlin.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>
