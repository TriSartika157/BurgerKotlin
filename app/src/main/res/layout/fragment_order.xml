<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- HEADER -->
        <TextView
            android:id="@+id/txt_kelola_menu"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="24dp"
            android:background="@drawable/bg_kelola_menu"
            android:elevation="6dp"
            android:fontFamily="@font/nunito_black"
            android:gravity="center"
            android:text="Tambah Menu Burger"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- FORM -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/form_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:background="@drawable/bg_circle"
            android:elevation="4dp"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/txt_kelola_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Nama -->
            <TextView
                android:id="@+id/label_nama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Burger"
                android:textStyle="bold"
                android:textColor="#000"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/et_nama_burger"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:padding="12dp"
                app:layout_constraintTop_toBottomOf="@id/label_nama"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Deskripsi -->
            <TextView
                android:id="@+id/label_deskripsi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Deskripsi Produk"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/et_nama_burger"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/et_deskripsi"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:padding="12dp"
                app:layout_constraintTop_toBottomOf="@id/label_deskripsi"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Harga -->
            <TextView
                android:id="@+id/label_harga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Harga"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/et_deskripsi"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/et_harga"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:inputType="number"
                android:padding="12dp"
                app:layout_constraintTop_toBottomOf="@id/label_harga"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Image -->
            <TextView
                android:id="@+id/label_upload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Upload Gambar"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/et_harga"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/linkUpload"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:padding="12dp"
                app:layout_constraintTop_toBottomOf="@id/label_upload"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- BUTTON -->
            <Button
                android:id="@+id/btn_simpan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Simpan"
                android:textColor="#FFF"
                android:background="@drawable/bg_button_green"
                app:layout_constraintTop_toBottomOf="@id/linkUpload"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_batal"
                app:layout_constraintWidth_percent="0.45"/>

            <Button
                android:id="@+id/btn_batal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Batal"
                android:textColor="#FFF"
                android:background="@drawable/bg_button_green"
                app:layout_constraintTop_toBottomOf="@id/linkUpload"
                app:layout_constraintStart_toEndOf="@id/btn_simpan"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.45"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- RECYCLER VIEW -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            app:layout_constraintTop_toBottomOf="@id/form_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
