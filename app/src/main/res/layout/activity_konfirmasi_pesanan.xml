<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF4C2"
    tools:context=".konfirmasi_pesanan">

    <!-- IC BAR (MENU) -->
    <ImageView
        android:id="@+id/icBar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="29dp"
        android:src="@drawable/ic_bar"
        android:contentDescription="Menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ICON CONFIRM -->
    <ImageView
        android:id="@+id/imgConfirm"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/konfirmasi"
        android:contentDescription="Order Confirmed"
        android:layout_marginTop="72dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TITLE -->
    <TextView
        android:id="@+id/tvConfirmed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Order Confirmed!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#41B146"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/imgConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SUBTITLE -->
    <TextView
        android:id="@+id/tvSuccess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your order has been placed\nsuccessfully"
        android:textSize="14sp"
        android:textColor="#FF8A00"
        android:gravity="center"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvConfirmed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- DELIVERY INFO -->
    <TextView
        android:id="@+id/tvDelivery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delivery by Thu, 29, 01:20 PM"
        android:textSize="14sp"
        android:textColor="#41B146"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/tvSuccess"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TRACK ORDER -->
    <TextView
        android:id="@+id/tvTrack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track my order"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#41B146"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvDelivery"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FOOTER TEXT -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="If you have any questions, please reach out\ndirectly to our customer support"
        android:textSize="12sp"
        android:textColor="#FF8A00"
        android:gravity="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
