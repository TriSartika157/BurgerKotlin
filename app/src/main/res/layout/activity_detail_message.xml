<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF4C2">

    <!-- Icon Menu -->
    <ImageView
        android:id="@+id/icMenu"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detail Pesanan"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FF8A00"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- White Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Nama + Love -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Zahra Cahya Dewi"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#4A2C2A"/>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/loveikon"/>
            </LinearLayout>

            <!-- Rating -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5.0"
                    android:textColor="#FF6F00"
                    android:textStyle="bold"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/rate"/>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F2C6A5"
                android:layout_marginVertical="12dp"/>

            <!-- Yellow Box -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                android:backgroundTint="#F6EDB7"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pesanan   : Chicken Burger"
                        android:textColor="#4A2C2A"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jumlah     : 2"
                        android:layout_marginTop="4dp"
                        android:textColor="#4A2C2A"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Harga : 20$"
                        android:layout_marginTop="4dp"
                        android:textStyle="bold"
                        android:textColor="#4A2C2A"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <!-- Pilih Keputusan -->
    <TextView
        android:id="@+id/tvPilihKeputusan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih Keputusan :"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#4A2C2A"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/cardDetail"
        app:layout_constraintStart_toStartOf="parent"/>

    <RadioGroup
        android:id="@+id/rgKeputusan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvPilihKeputusan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Item -->
        <RadioButton
            android:id="@+id/rbProses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pesanan Dapat Di Proses"
            android:padding="16dp"
            android:buttonTint="#FF6F00"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFCCBC"/>

        <RadioButton
            android:id="@+id/rbStok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stok Burger Tersedia"
            android:padding="16dp"
            android:buttonTint="#FF6F00"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFCCBC"/>

        <RadioButton
            android:id="@+id/rbBayar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pembayaran Valid"
            android:padding="16dp"
            android:buttonTint="#FF6F00"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFCCBC"/>

        <RadioButton
            android:id="@+id/rbAlamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alamat Jelas"
            android:padding="16dp"
            android:buttonTint="#FF6F00"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFCCBC"/>

        <RadioButton
            android:id="@+id/rbTolak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pesanan Di Tolak"
            android:padding="16dp"
            android:buttonTint="#FF6F00"/>
    </RadioGroup>

    <!-- Catatan Admin -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCatatan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        android:backgroundTint="#FFF6D5"
        app:layout_constraintTop_toBottomOf="@id/rgKeputusan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etCatatan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Catatan Admin (Opsional) :"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:minHeight="80dp"
            android:gravity="top"/>
    </androidx.cardview.widget.CardView>

    <!-- Button Submit -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:text="Submit"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#41B146"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardCatatan"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
